# The statue database is built and seeded from database/data/statues.csv at image build time.
# The only runtime writes are the expert's reviews, which go to Supabase through REVIEWS_DB_URL.

FROM node:22-bookworm-slim AS assets
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY vite.config.js ./
COPY resources ./resources
RUN mkdir -p public && npm run build

FROM dunglas/frankenphp:1-php8.4-bookworm AS base
RUN install-php-extensions intl zip pdo_sqlite pdo_pgsql
WORKDIR /app

FROM base AS vendor
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction

FROM base AS runtime
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY . .
COPY --from=vendor /app/vendor ./vendor
COPY --from=assets /app/public/build ./public/build

ENV APP_ENV=production \
    APP_DEBUG=false \
    APP_LOCALE=id \
    APP_FALLBACK_LOCALE=id \
    LOG_CHANNEL=stderr \
    DB_CONNECTION=sqlite \
    DB_DATABASE=/app/database/database.sqlite \
    SESSION_DRIVER=cookie \
    SESSION_LIFETIME=43200 \
    SESSION_SECURE_COOKIE=true \
    CACHE_STORE=array \
    QUEUE_CONNECTION=sync \
    PORT=80

RUN mkdir -p storage/framework/views storage/framework/cache/data storage/framework/sessions storage/logs bootstrap/cache \
    && composer dump-autoload --optimize --no-dev --no-interaction \
    && touch database/database.sqlite \
    && php artisan migrate --force --seed --no-interaction \
    && php artisan view:cache \
    && rm /usr/bin/composer \
    && chown -R www-data:www-data storage bootstrap/cache database /data/caddy /config/caddy \
    && setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp

COPY Caddyfile /etc/frankenphp/Caddyfile

USER www-data
EXPOSE 80
CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
