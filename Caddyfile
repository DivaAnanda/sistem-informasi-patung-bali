:{$PORT:80} {
	root * /app/public
	encode zstd gzip

	# Vite file names change with their content, so browsers and the CDN may keep them forever.
	@hashed path /build/*
	header @hashed Cache-Control "public, max-age=31536000, s-maxage=31536000, immutable"

	# Photos and videos are never edited in place; a week in the browser, a month at the CDN.
	@media path /images/* /favicon.ico /robots.txt
	header @media Cache-Control "public, max-age=604800, s-maxage=2592000, stale-while-revalidate=86400"

	php_server {
		try_files {path} index.php
	}
}
